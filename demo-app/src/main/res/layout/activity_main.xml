<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true">

    <!-- Three panes swapped by the bottom navigation: the SDK method demos, the same stories
         block through the Compose wrapper, and through the classic XML view. -->
    <FrameLayout
        android:id="@+id/contentContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

    <ScrollView
        android:id="@+id/apiContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:gravity="center">

        <!-- Registered push provider + token, with Copy / HTTP Log. Lives in the API pane: it is
             part of the SDK method demos, not a header shared by the stories tabs. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/token_panel_background"
            android:padding="12dp">

            <TextView
                android:id="@+id/tvPushTokenLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/push_token_label"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvPushTokenType"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/push_token_type_placeholder"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvPushToken"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/push_token_placeholder"
                android:textIsSelectable="true"
                android:maxLines="6"
                android:ellipsize="end" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">

                <Button
                    android:id="@+id/btnCopyToken"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/push_token_copy" />

                <Button
                    android:id="@+id/btnHttpLog"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/http_log_open" />
            </LinearLayout>
        </LinearLayout>

            <Button
                android:id="@+id/btnShowTestPopup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/show_test_popup"
                android:layout_marginTop="16dp" />

            <Button
                android:id="@+id/btnTrackEventCustomFields"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/track_event_custom_fields"
                android:layout_marginTop="16dp" />

            <Button
                android:id="@+id/btnTrackEventCollision"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/track_event_reserved_collision"
                android:layout_marginTop="16dp" />

            <Button
                android:id="@+id/btnTrackViewNoParams"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/track_view_no_params"
                android:layout_marginTop="24dp" />

            <Button
                android:id="@+id/btnTrackViewWithParams"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/track_view_with_params"
                android:layout_marginTop="16dp" />

            <Button
                android:id="@+id/btnPredictDidOnly"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/predict_did_only"
                android:layout_marginTop="24dp" />

            <Button
                android:id="@+id/btnPredictWithEmail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/predict_with_email"
                android:layout_marginTop="16dp" />

            <Button
                android:id="@+id/btnTrackPurchaseMinimal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/track_purchase_minimal"
                android:layout_marginTop="24dp" />

            <Button
                android:id="@+id/btnTrackPurchaseFull"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/track_purchase_full"
                android:layout_marginTop="16dp" />

            <Button
                android:id="@+id/btnGetLastOrderProducts"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/get_last_order_products"
                android:layout_marginTop="24dp" />

            <Button
                android:id="@+id/btnGetUserOrders"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/get_user_orders"
                android:layout_marginTop="16dp" />

            <Button
                android:id="@+id/btnLoyaltyJoin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/loyalty_join"
                android:layout_marginTop="24dp" />

            <Button
                android:id="@+id/btnLoyaltyStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/loyalty_status"
                android:layout_marginTop="16dp" />

            <Button
                android:id="@+id/btnGetProfile"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/get_profile"
                android:layout_marginTop="24dp" />

            <Button
                android:id="@+id/btnGetProductCounters"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/get_product_counters"
                android:layout_marginTop="16dp" />

            <Button
                android:id="@+id/btnGetCategory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/get_category"
                android:layout_marginTop="16dp" />

            <Button
                android:id="@+id/btnGetCollection"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/get_collection"
                android:layout_marginTop="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/tracking_namespace_title"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnTrackingProductView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tracking_product_view"
                android:layout_marginTop="8dp" />

            <Button
                android:id="@+id/btnTrackingCategoryView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tracking_category_view"
                android:layout_marginTop="8dp" />

            <Button
                android:id="@+id/btnTrackingSearch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tracking_search"
                android:layout_marginTop="8dp" />

            <Button
                android:id="@+id/btnTrackingAddToCart"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tracking_add_to_cart"
                android:layout_marginTop="8dp" />

            <Button
                android:id="@+id/btnTrackingSyncCart"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tracking_sync_cart"
                android:layout_marginTop="8dp" />

            <Button
                android:id="@+id/btnTrackingRemoveFromCart"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tracking_remove_from_cart"
                android:layout_marginTop="8dp" />

            <Button
                android:id="@+id/btnTrackingAddToFavorites"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tracking_add_to_favorites"
                android:layout_marginTop="8dp" />

            <Button
                android:id="@+id/btnTrackingSyncFavorites"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tracking_sync_favorites"
                android:layout_marginTop="8dp" />

            <Button
                android:id="@+id/btnTrackingRemoveFromFavorites"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tracking_remove_from_favorites"
                android:layout_marginTop="8dp" />

            <Button
                android:id="@+id/btnTrackingSetSource"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tracking_set_source"
                android:layout_marginTop="8dp" />

            <TextView
                android:id="@+id/tvTrackingNamespaceResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/tracking_namespace_result_placeholder"
                android:textIsSelectable="true"
                android:typeface="monospace" />

        </LinearLayout>

    </ScrollView>

        <androidx.compose.ui.platform.ComposeView
            android:id="@+id/uiKitContent"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <ScrollView
            android:id="@+id/legacyContent"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/legacy_stories_title"
                    android:textStyle="bold" />

                <!-- The block is declared in XML with app:code and loads itself: on attach the view
                     resolves its SDK instance through Rees46 and fetches the block, so several blocks
                     can live on screen at once with no manual wiring.
                     Kept on a white background: the block colors its labels from merchant settings
                     (assuming a light backdrop), so it must stay light even when the demo is dark. -->
                <com.personalization.stories.views.StoriesView
                    android:id="@+id/storiesView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@android:color/white"
                    app:code="@string/stories_code" />

                <TextView
                    android:id="@+id/tvLegacyStoriesLog"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/legacy_stories_log_placeholder"
                    android:textIsSelectable="true"
                    android:typeface="monospace" />
            </LinearLayout>
        </ScrollView>

        <androidx.compose.ui.platform.ComposeView
            android:id="@+id/multiInstanceContent"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Bridge theme so the Material component resolves its attributes while the app itself
         stays on the AppCompat theme. -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:theme="@style/Theme.MaterialComponents.DayNight.Bridge"
        android:background="@color/token_panel_background"
        app:labelVisibilityMode="labeled"
        app:itemIconTint="@color/bottom_nav_item"
        app:itemTextColor="@color/bottom_nav_item"
        app:menu="@menu/bottom_nav_menu" />
</LinearLayout>
